{
  "name": "kept",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Kept: a private commitment memory. Relate in the browser, Firebase AI Logic hybrid inference (Gemini Nano on the device, Gemini in the cloud).",
  "license": "Apache-2.0",
  "scripts": {
    "copy-relate": "node scripts/copy-relate.mjs",
    "postinstall": "npm run copy-relate",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed-store": "node scripts/seed-store.mjs",
    "graph": "node scripts/graph.mjs",
    "query": "node scripts/query.mjs",
    "test": "node --test test/*.test.mjs",
    "test:wasm": "node scripts/test-wasm.mjs",
    "eval": "node scripts/run-eval.mjs"
  },
  "dependencies": {
    "@relate/relate-wasm": "1.0.1",
    "firebase": "^13.3.0"
  },
  "devDependencies": {
    "@relate/relate": "^1.0.1",
    "playwright": "^1.65.1",
    "vite": "^5.4.21"
  }
}
